{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supervisor artifact evidence, local benchmark only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context",
    "startedAt",
    "finishedAt",
    "expiresAt",
    "target",
    "apk",
    "inspector",
    "builds",
    "signing",
    "preflight"
  ],
  "properties": {
    "schema": {
      "const": "micro.android.artifact-record/1"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "adapterId",
        "sourceSha",
        "identities"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "adapterId": {
          "const": "expo-android"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceArchive",
            "sourceLock",
            "policy",
            "adapter",
            "toolchain",
            "recipe",
            "suite",
            "recovery",
            "npmSeal",
            "mavenSeal",
            "scannerPolicy"
          ],
          "properties": {
            "sourceArchive": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sourceLock": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "adapter": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "toolchain": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "recipe": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "suite": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "recovery": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "npmSeal": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "mavenSeal": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scannerPolicy": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "startedAt": {
      "type": "number",
      "minimum": 0
    },
    "finishedAt": {
      "type": "number",
      "minimum": 0
    },
    "expiresAt": {
      "type": "number",
      "minimum": 0
    },
    "target": {
      "const": "local-benchmark"
    },
    "apk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "builds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source-admission",
        "source-security",
        "offline-checks"
      ],
      "properties": {
        "source-admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "source-security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "offline-checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
