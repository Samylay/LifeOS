{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Administrative Android fixture binding, never candidate-selected",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectKind",
    "projectId",
    "adapterId",
    "sourceSha",
    "identities",
    "certificateSha256",
    "expiresAt",
    "versionCode",
    "versionName",
    "package",
    "minSdk",
    "targetSdk",
    "permissions",
    "admitted",
    "image",
    "runtimePolicy",
    "nativeMapping"
  ],
  "properties": {
    "schema": {
      "const": "micro.android.adapter/1"
    },
    "projectKind": {
      "const": "fixture"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "adapterId": {
      "const": "expo-android"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceArchive",
        "sourceLock",
        "policy",
        "adapter",
        "toolchain",
        "recipe",
        "suite",
        "recovery",
        "npmSeal",
        "mavenSeal",
        "scannerPolicy"
      ],
      "properties": {
        "sourceArchive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sourceLock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "npmSeal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "mavenSeal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "scannerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "certificateSha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "type": "number",
      "minimum": 0
    },
    "versionCode": {
      "const": 1
    },
    "versionName": {
      "const": "1.0.0"
    },
    "package": {
      "const": "app.micro.factory.fixture"
    },
    "minSdk": {
      "const": 24
    },
    "targetSdk": {
      "const": 36
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "admitted": {
      "type": "boolean"
    },
    "image": {
      "const": "sha256:43778b0b9227ffc8d12a9092f011f09238a77c92b5fcde6a18310757ccef7305"
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "network",
        "memoryBytes",
        "memorySwapBytes",
        "nanoCpus",
        "pids"
      ],
      "properties": {
        "user": {
          "const": "1000:1000"
        },
        "network": {
          "const": "none"
        },
        "memoryBytes": {
          "const": 6442450944
        },
        "memorySwapBytes": {
          "const": 6442450944
        },
        "nanoCpus": {
          "const": 2000000000
        },
        "pids": {
          "const": 384
        }
      }
    },
    "nativeMapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "admitted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "certificateSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sealedTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "files",
        "manifestSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reviewedAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceExporterSha256",
        "sourceExport",
        "nativeInputs"
      ],
      "properties": {
        "schema": {
          "const": "micro.android.reviewed-adapter/1"
        },
        "sourceExporterSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceExport": {
          "$ref": "#/$defs/evidence"
        },
        "nativeInputs": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "sourceExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceSha",
        "sourceArchiveSha256",
        "sourceLock",
        "exporterSha256",
        "tree"
      ],
      "properties": {
        "schema": {
          "const": "micro.android.source-export/1"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceArchiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceLock": {
          "$ref": "#/$defs/evidence"
        },
        "exporterSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tree": {
          "$ref": "#/$defs/sealedTree"
        }
      }
    },
    "nativeInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceExport",
        "identities",
        "seeds",
        "outputRoot"
      ],
      "properties": {
        "schema": {
          "const": "micro.android.native-inputs/1"
        },
        "sourceExport": {
          "$ref": "#/$defs/evidence"
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolchain",
            "npmSeal",
            "mavenSeal",
            "recipe"
          ],
          "properties": {
            "toolchain": {
              "$ref": "#/$defs/evidence"
            },
            "npmSeal": {
              "$ref": "#/$defs/evidence"
            },
            "mavenSeal": {
              "$ref": "#/$defs/evidence"
            },
            "recipe": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "seeds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/seed/fixture",
            "/seed/tools",
            "/seed/patch-preimages.json",
            "/seed/npm-cache",
            "/seed/gradle-caches",
            "/seed/verification-metadata.xml"
          ],
          "properties": {
            "/seed/fixture": {
              "$ref": "#/$defs/sealedTree"
            },
            "/seed/tools": {
              "$ref": "#/$defs/sealedTree"
            },
            "/seed/patch-preimages.json": {
              "$ref": "#/$defs/sealedTree"
            },
            "/seed/npm-cache": {
              "$ref": "#/$defs/sealedTree"
            },
            "/seed/gradle-caches": {
              "$ref": "#/$defs/sealedTree"
            },
            "/seed/verification-metadata.xml": {
              "$ref": "#/$defs/sealedTree"
            }
          }
        },
        "outputRoot": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        }
      }
    },
    "nativeExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "argv",
        "environment",
        "worker"
      ],
      "properties": {
        "entrypoint": {
          "const": [
            "python3"
          ]
        },
        "argv": {
          "const": [
            "/seed/tools/native_fixture_job.py",
            "--offline"
          ]
        },
        "environment": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(PATH|NODE_VERSION|YARN_VERSION|JAVA_HOME|ANDROID_HOME|ANDROID_SDK_ROOT|ANDROID_USER_HOME|EXPO_OFFLINE|EXPO_NO_TELEMETRY|HOME|JAVA_TOOL_OPTIONS)=[^\\u0000\\r\\n]*$"
          }
        },
        "worker": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "nativeRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "commands",
        "execution"
      ],
      "properties": {
        "schema": {
          "const": "micro.android.native-recipe/1"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "execution": {
          "$ref": "#/$defs/nativeExecution"
        }
      }
    }
  },
  "$comment": "The adapter identity hashes a separately operator-reviewed reviewedAdapter object. Its sourceExport and nativeInputs references pin complete independently exported source/seed manifests. Context hashes exclude these objects own enclosing adapter digest to avoid circular authority. No candidate may select these references, mount roots or files. Native recipe execution binds actual Docker Config.Entrypoint/Cmd/Env and Path/Args to the exact offline worker bytes inside the complete pinned tools seed; full environment must come from operator-reviewed actual image/job observations. No actual recipe or worker is supplied by this schema."
}
